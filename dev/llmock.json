{
  "defaultModel": "bitagent",
  "models": {
    "bitagent": {
      "name": "openai",
      "model": "bitagent-mock",
      "endpoint": "v1/chat/completions",
      "responseType": "stored",
      "storedResponsesFile": "fixtures/default.json",
      "maxLoremParas": 1,
      "validateRequests": true,
      "logRequests": false,
      "debug": false,
      "stream": true,
      "responseDelay": {
        "min": 25,
        "max": 25
      },
      "embeddings": {
        "enabled": false,
        "dimensions": 128
      },
      "chaos": {
        "enabled": false
      },
      "responseRules": [
        {
          "match": "[error]",
          "fail": {
            "kind": "http",
            "status": 500
          }
        },
        {
          "match": "[length]",
          "text": "This answer reached the fixture token limit.",
          "stopReason": "max_tokens"
        },
        {
          "match": "[summary]",
          "file": "fixtures/summary.txt"
        }
      ]
    }
  },
  "server": {
    "host": "127.0.0.1",
    "port": 4317,
    "admin": false
  }
}
