{
  "name": "@bitagent/core",
  "version": "0.1.0",
  "description": "Structured coroutine Jobs and Host execution boundaries.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-Hans.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "node dev/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.portable.json --noEmit",
    "test": "pnpm run build && node dev/test.mjs",
    "check": "pnpm run typecheck && pnpm run test",
    "mock:start": "node --import tsx dev/llmock/server.mjs",
    "mock:submit": "node --import tsx dev/llmock/server.mjs --model submit --port 4318"
  },
  "dependencies": {
    "effection": "4.2.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "llmock": "3.14.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
