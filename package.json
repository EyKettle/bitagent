{
  "name": "bitagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.8.0 <25"
  },
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node --experimental-vm-modules --experimental-import-meta-resolve dist/interface/console/index.js",
    "test": "pnpm run build && node --experimental-vm-modules --experimental-import-meta-resolve --test test/*.test.mjs"
  },
  "dependencies": {
    "@types/node": "^24.19.4",
    "cjs-module-lexer": "^2.3.0",
    "typescript": "^6.0.3"
  }
}
